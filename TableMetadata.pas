unit TableMetadata;
{$mode objfpc}{$H+}{$codepage utf8}
interface
uses SysUtils, DB, SQLDB;
function QuoteName(const S: string): string;
function ColumnSQL(const TableName: string): string;
function MetadataSQL(const TableName: string; Kind: Integer): string;
function FieldTypeName(Q: TSQLQuery): string;
implementation
function QuoteName(const S: string): string;
begin
  Result := '"' + StringReplace(S, '"', '""', [rfReplaceAll]) + '"';
end;
function ColumnSQL(const TableName: string): string;
begin
  Result := 'SELECT TRIM(RF.RDB$FIELD_NAME) AS FIELD_NAME, F.RDB$FIELD_TYPE AS TYPE_CODE, ' +
    'F.RDB$FIELD_SUB_TYPE AS SUB_TYPE, F.RDB$FIELD_PRECISION AS FIELD_PRECISION, ' +
    'F.RDB$FIELD_SCALE AS FIELD_SCALE, F.RDB$CHARACTER_LENGTH AS CHARACTER_COUNT, ' +
    'TRIM(CS.RDB$CHARACTER_SET_NAME) AS CHARSET_NAME, TRIM(CO.RDB$COLLATION_NAME) AS COLLATION_NAME, ' +
    'COALESCE(RF.RDB$DEFAULT_SOURCE,F.RDB$DEFAULT_SOURCE) AS DEFAULT_SOURCE, ' +
    'COALESCE(RF.RDB$NULL_FLAG,F.RDB$NULL_FLAG,0) AS NOT_NULL_FLAG, ' +
    'F.RDB$COMPUTED_SOURCE AS COMPUTED_SOURCE, RF.RDB$FIELD_SOURCE AS FIELD_SOURCE, ' +
    'RF.RDB$IDENTITY_TYPE AS IDENTITY_TYPE, ' +
    'RF.RDB$DESCRIPTION AS DESCRIPTION FROM RDB$RELATION_FIELDS RF ' +
    'JOIN RDB$FIELDS F ON RF.RDB$FIELD_SOURCE=F.RDB$FIELD_NAME ' +
    'LEFT JOIN RDB$CHARACTER_SETS CS ON CS.RDB$CHARACTER_SET_ID=F.RDB$CHARACTER_SET_ID ' +
    'LEFT JOIN RDB$COLLATIONS CO ON CO.RDB$CHARACTER_SET_ID=F.RDB$CHARACTER_SET_ID ' +
    'AND CO.RDB$COLLATION_ID=COALESCE(RF.RDB$COLLATION_ID,F.RDB$COLLATION_ID) ' +
    'WHERE RF.RDB$RELATION_NAME=' + QuotedStr(TableName) + ' ORDER BY RF.RDB$FIELD_POSITION';
end;
function MetadataSQL(const TableName: string; Kind: Integer): string;
var N: string;
begin
  N := QuotedStr(TableName);
  case Kind of
    1: Result := 'SELECT TRIM(I.RDB$INDEX_NAME) AS INDEX_NAME, I.RDB$UNIQUE_FLAG AS UNIQUE_FLAG, ' +
      'I.RDB$INDEX_TYPE AS DESCENDING_FLAG, I.RDB$INDEX_INACTIVE AS INACTIVE, ' +
      'TRIM(S.RDB$FIELD_NAME) AS COLUMN_NAME, S.RDB$FIELD_POSITION AS COLUMN_POSITION, ' +
      'I.RDB$EXPRESSION_SOURCE AS EXPRESSION_SQL FROM RDB$INDICES I ' +
      'LEFT JOIN RDB$INDEX_SEGMENTS S ON S.RDB$INDEX_NAME=I.RDB$INDEX_NAME ' +
      'WHERE I.RDB$RELATION_NAME=' + N + ' ORDER BY I.RDB$INDEX_NAME,S.RDB$FIELD_POSITION';
    2: Result := 'SELECT TRIM(C.RDB$CONSTRAINT_NAME) AS CONSTRAINT_NAME, ' +
      'TRIM(C.RDB$CONSTRAINT_TYPE) AS CONSTRAINT_TYPE, TRIM(S.RDB$FIELD_NAME) AS COLUMN_NAME, ' +
      'S.RDB$FIELD_POSITION AS COLUMN_POSITION FROM RDB$RELATION_CONSTRAINTS C ' +
      'LEFT JOIN RDB$INDEX_SEGMENTS S ON S.RDB$INDEX_NAME=C.RDB$INDEX_NAME ' +
      'WHERE C.RDB$RELATION_NAME=' + N + ' AND C.RDB$CONSTRAINT_TYPE IN (''PRIMARY KEY'',''UNIQUE'') ' +
      'ORDER BY C.RDB$CONSTRAINT_NAME,S.RDB$FIELD_POSITION';
    3: Result := 'SELECT TRIM(C.RDB$CONSTRAINT_NAME) AS CONSTRAINT_NAME, T.RDB$TRIGGER_SOURCE AS CHECK_SQL ' +
      'FROM RDB$RELATION_CONSTRAINTS C JOIN RDB$CHECK_CONSTRAINTS K ON K.RDB$CONSTRAINT_NAME=C.RDB$CONSTRAINT_NAME ' +
      'JOIN RDB$TRIGGERS T ON T.RDB$TRIGGER_NAME=K.RDB$TRIGGER_NAME ' +
      'WHERE C.RDB$RELATION_NAME=' + N + ' AND C.RDB$CONSTRAINT_TYPE=''CHECK'' ORDER BY C.RDB$CONSTRAINT_NAME';
    4: Result := 'SELECT TRIM(C.RDB$CONSTRAINT_NAME) AS CONSTRAINT_NAME, TRIM(S.RDB$FIELD_NAME) AS COLUMN_NAME, ' +
      'TRIM(P.RDB$RELATION_NAME) AS REFERENCED_TABLE, TRIM(PS.RDB$FIELD_NAME) AS REFERENCED_COLUMN, ' +
      'TRIM(R.RDB$UPDATE_RULE) AS UPDATE_RULE, TRIM(R.RDB$DELETE_RULE) AS DELETE_RULE ' +
      'FROM RDB$RELATION_CONSTRAINTS C JOIN RDB$REF_CONSTRAINTS R ON R.RDB$CONSTRAINT_NAME=C.RDB$CONSTRAINT_NAME ' +
      'JOIN RDB$RELATION_CONSTRAINTS P ON P.RDB$CONSTRAINT_NAME=R.RDB$CONST_NAME_UQ ' +
      'JOIN RDB$INDEX_SEGMENTS S ON S.RDB$INDEX_NAME=C.RDB$INDEX_NAME ' +
      'JOIN RDB$INDEX_SEGMENTS PS ON PS.RDB$INDEX_NAME=P.RDB$INDEX_NAME AND PS.RDB$FIELD_POSITION=S.RDB$FIELD_POSITION ' +
      'WHERE C.RDB$RELATION_NAME=' + N + ' ORDER BY C.RDB$CONSTRAINT_NAME,S.RDB$FIELD_POSITION';
    5: Result := 'SELECT TRIM(RDB$TRIGGER_NAME) AS TRIGGER_NAME, RDB$TRIGGER_TYPE AS TRIGGER_TYPE, ' +
      'RDB$TRIGGER_SEQUENCE AS EXECUTION_ORDER, RDB$TRIGGER_INACTIVE AS INACTIVE, RDB$TRIGGER_SOURCE AS SOURCE_SQL ' +
      'FROM RDB$TRIGGERS WHERE RDB$RELATION_NAME=' + N + ' AND COALESCE(RDB$SYSTEM_FLAG,0)=0 ORDER BY RDB$TRIGGER_NAME';
    6: Result := 'SELECT TRIM(RDB$DEPENDENT_NAME) AS DEPENDENT_NAME, RDB$DEPENDENT_TYPE AS OBJECT_TYPE, ' +
      'TRIM(RDB$FIELD_NAME) AS COLUMN_NAME FROM RDB$DEPENDENCIES WHERE RDB$DEPENDED_ON_NAME=' + N + ' ORDER BY RDB$DEPENDENT_NAME';
    7: Result := 'SELECT TRIM(RDB$USER) AS GRANTEE, RDB$USER_TYPE AS GRANTEE_TYPE, ' +
      'RDB$PRIVILEGE AS PRIVILEGE_CODE, RDB$GRANT_OPTION AS GRANT_OPTION, TRIM(RDB$GRANTOR) AS GRANTOR, ' +
      'TRIM(RDB$FIELD_NAME) AS COLUMN_NAME FROM RDB$USER_PRIVILEGES WHERE RDB$RELATION_NAME=' + N + ' ORDER BY RDB$USER';
    8: Result := 'SELECT TRIM(RDB$OWNER_NAME) AS OWNER_NAME, RDB$RELATION_TYPE AS RELATION_TYPE, ' +
      'RDB$DESCRIPTION AS DESCRIPTION, RDB$VIEW_SOURCE AS VIEW_SQL, TRIM(RDB$SECURITY_CLASS) AS SECURITY_CLASS ' +
      'FROM RDB$RELATIONS WHERE RDB$RELATION_NAME=' + N;
    else raise Exception.Create('Unknown metadata kind');
  end;
end;
function FieldTypeName(Q: TSQLQuery): string;
var Code, SubType, Precision, Scale: Integer;
begin
  Code := Q.FieldByName('TYPE_CODE').AsInteger;
  SubType := Q.FieldByName('SUB_TYPE').AsInteger;
  Precision := Q.FieldByName('FIELD_PRECISION').AsInteger;
  Scale := -Q.FieldByName('FIELD_SCALE').AsInteger;
  if (Code in [7,8,16,26]) and (SubType in [1,2]) then
  begin
    if SubType=1 then Result:='NUMERIC' else Result:='DECIMAL';
    Exit(Result+'('+IntToStr(Precision)+','+IntToStr(Scale)+')');
  end;
  case Code of
    7: Result:='SMALLINT'; 8: Result:='INTEGER'; 10: Result:='FLOAT';
    12: Result:='DATE'; 13: Result:='TIME'; 16: Result:='BIGINT';
    23: Result:='BOOLEAN'; 24: Result:='DECFLOAT(16)'; 25: Result:='DECFLOAT(34)';
    26: Result:='INT128'; 27: Result:='DOUBLE PRECISION';
    28: Result:='TIME WITH TIME ZONE'; 29: Result:='TIMESTAMP WITH TIME ZONE';
    35: Result:='TIMESTAMP';
    14: Result:='CHAR('+Q.FieldByName('CHARACTER_COUNT').AsString+')';
    37: Result:='VARCHAR('+Q.FieldByName('CHARACTER_COUNT').AsString+')';
    261: Result:='BLOB SUB_TYPE '+IntToStr(SubType);
    else Result:='TYPE '+IntToStr(Code);
  end;
end;
end.
